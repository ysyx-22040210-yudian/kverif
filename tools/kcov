#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$script_dir/.." && pwd)"

configure_verdi_runtime() {
  local verdi_bin="" candidate="" npi_tcl="" npi_lib="" resolved=""

  if [[ -z "${VERDI_HOME:-}" ]]; then
    verdi_bin="$(command -v verdi 2>/dev/null || true)"
    if [[ -n "$verdi_bin" ]]; then
      if command -v readlink >/dev/null 2>&1; then
        resolved="$(readlink -f "$verdi_bin" 2>/dev/null || true)"
        [[ -z "$resolved" ]] || verdi_bin="$resolved"
      fi
      candidate="$(cd "$(dirname "$verdi_bin")/.." 2>/dev/null && pwd -P || true)"
      if [[ -f "$candidate/share/NPI/L1/TCL/npi_L1.tcl" ]]; then
        export VERDI_HOME="$candidate"
      fi
    fi
  fi

  if [[ -n "${VERDI_HOME:-}" ]]; then
    npi_tcl="$VERDI_HOME/share/NPI/L1/TCL"
    if [[ -z "${NPIL1_PATH:-}" && -f "$npi_tcl/npi_L1.tcl" ]]; then
      export NPIL1_PATH="$npi_tcl"
    fi

    npi_lib="$VERDI_HOME/share/NPI/lib/LINUX64"
    if [[ ! -d "$npi_lib" ]]; then
      npi_lib="$VERDI_HOME/share/NPI/lib/linux64"
    fi
    if [[ -d "$npi_lib" ]]; then
      case ":${LD_LIBRARY_PATH:-}:" in
        *":$npi_lib:"*) ;;
        *) export LD_LIBRARY_PATH="$npi_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
      esac
    fi
  fi
}

configure_verdi_runtime

python_bin="${PYTHON:-${KVERIF_KCOV_PYTHON:-}}"
if [[ -z "$python_bin" ]]; then
  if [[ -x "${HOME}/miniconda3/envs/kverif-mcp/bin/python" ]]; then
    python_bin="${HOME}/miniconda3/envs/kverif-mcp/bin/python"
  elif command -v python3.11 >/dev/null 2>&1; then
    python_bin="python3.11"
  elif [[ -x "${VERDI_HOME:-}/platform/linux64/Python/bin/python" ]]; then
    python_bin="${VERDI_HOME}/platform/linux64/Python/bin/python"
  else
    python_bin="python3"
  fi
fi

export PYTHONPATH="$root/kcov${PYTHONPATH:+:${PYTHONPATH}}"
exec "$python_bin" -m kcov.cli "$@"
